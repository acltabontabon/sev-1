# Godot-generated cache and imported translations.
.godot/
*.translation

# Local builds, diagnostics, tools, and OS metadata.
/builds/
/logs/
/.tools/
.DS_Store
__pycache__/

# Local credentials must never enter source control.
.env
.env.*
!.env.example
export_credentials.cfg
*.p12
*.pfx

# Kevin Iglesias' free motions permit game use, not standalone redistribution.
# Keep licensed source files and derived animation resources local in this public repo.
/assets/characters/kevin_trial/*.fbx
/assets/characters/kevin_trial/*.fbx.import
/assets/characters/kevin_trial/*.res

# Fab Standard License: keep the Reaper comparison asset local.
/assets/enemies/reaper_trial/*.glb
/assets/enemies/reaper_trial/*.glb.import
/assets/enemies/reaper_trial/*.png
/assets/enemies/reaper_trial/*.png.import
