extends "res://tests/incident_tests.gd"
## Player-facing transitions and actual E input. Staged travel is not a pacing playtest.


func investigation() -> void:
	scene.reset_encounter()
	player.camera_rig.set_capture(true)
	incident.presentation.skip()
	incident._cleanup()
	incident._enter(incident.Stage.INVESTIGATION)
	await frames(3)


func _run() -> void:
	scene = load("res://game/incidents/missing_transaction.tscn").instantiate()
	root.add_child(scene)
	current_scene = scene
	player = scene.get_node("Player")
	incident = scene.get_node("Incident")
	player.camera_rig.set_capture(true)
	incident.outbreak_in_headless = true
	incident.presentation.skip()
	await frames(180)
	var outbreak: Dictionary = incident.next_step()
	check(incident.armed and outbreak.get("tag", "") == "???" and "Wave 1/2" in outbreak.get("text", ""), "opening hands control to an actionable first-wave objective")
	var host: Node3D = incident._strangest()
	check(is_instance_valid(host) and str(host.get_meta("area")) in outbreak.get("text", "") and (outbreak.point as Vector3).distance_to(host.global_position) < .1, "outbreak guidance names the area and points to the employee who can start it")
	incident.outbreak_in_headless = false
	await investigation()
	player.position = incident.interactions.coffee.position + Vector3(-1, 0, 0)
	check("COFFEE" in incident.next_step().text, "NEXT agrees with the nearby coffee prompt instead of asking for the call")
	await key(KEY_E)
	check(incident.coffee_cups == 1 and not incident.management_call.active, "E honors the pantry prompt during investigation instead of answering the call")
	player.position = incident.coworkers.person("Intern").body.global_position + Vector3(1, 0, 0)
	check("E talk" in incident.next_step().text, "NEXT agrees with the nearby coworker prompt")
	await key(KEY_E)
	check(incident.dialogue.is_open() and not incident.management_call.active, "E honors an overtime coworker's talk prompt before Management")
	await investigation()
	player.position = Vector3(-8, .05, 8)
	await key(KEY_E)
	check(incident.management_call.active, "away from local interactions E answers Management without a compulsory walk")
	incident.presentation.skip()
	incident.choose_corporate(1)
	await frames(3)
	check(incident.stage == incident.Stage.ENCOUNTER_TWO and not paused and not player.narrative_hold, "the call hands off through the decision into playable containment")
	await investigation()
	check("Optional" in incident.room.get_node("SyncDetail").text, "Quick Sync advertises its optional role before entry")
	player.position = Vector3(17.7, .05, -8.75)
	check("Optional Quick Sync" in incident.next_step().text, "the meeting doorway previews an optional fight and reward before locking the doors")
	player.position = Vector3(24, .05, -8)
	player.max_health = 10000
	player.health = 10000
	await frames(3)
	check(incident.quick_sync == "active" and not incident.management_call.active, "entering the optional room starts its encounter before the call")
	await key(KEY_E)
	check(not incident.management_call.active, "Management cannot interrupt the locked Quick Sync fight")
	for foe: CharacterBody3D in incident.sync_alive.duplicate():
		foe.drop_shield()
		foe.receive_damage(10000, player.position)
	await frames(3)
	check(incident.quick_sync == "done" and incident.room.get_node("QuickSyncDoorA").collision_layer == 0, "optional encounter releases its doors and returns to the main objective")
	player.position = Vector3(-8, .05, 8)
	await key(KEY_E)
	check(incident.management_call.active, "finishing Quick Sync reconnects to Management")
	await investigation()
	incident._enter(incident.Stage.ENCOUNTER_TWO)
	incident._cleanup()
	incident._enter(incident.Stage.BOSS)
	incident.presentation.boss_seen = true
	player.position = Vector3(-8, .05, 8)
	await frames(3)
	var hud: CanvasLayer = scene.get_node("HUD")
	check(not hud.guide.get_global_rect().intersects(incident.presentation.feed.get_global_rect()), "NEXT stays outside the notification lane during the vault handoff")
	var route: Dictionary = incident.next_step()
	check(incident.reachable(route.point), "the corridor guidance point is reachable from the office navigation floor")
	check(route.tag == "CORRIDOR" and (route.point as Vector3).z > incident.VAULT_LINE, "the office guides to the corridor entrance before the vault")
	player.position = Vector3(9, .05, -18)
	route = incident.next_step()
	check(incident.reachable(route.point), "the vault guidance point is reachable through the server corridor")
	check(route.tag == "VAULT" and (route.point as Vector3).z < incident.VAULT_LINE, "the corridor waypoint crosses the actual boss trigger instead of ending short")
	player.global_position = route.point
	await frames(3)
	check(incident.boss_triggered, "reaching the advertised vault waypoint starts the boss arrival")
	incident.presentation.skip()
	await frames(3)
	check(is_instance_valid(incident.boss) and not player.narrative_hold and "OPEN" in incident.next_step().text, "skipping arrival hands back a live boss and its vulnerability instruction")
	scene.reset_encounter()
	await frames(3)
	check(incident.stage == incident.Stage.ALERT and incident.room.get_node("VaultGate").collision_layer == 1 and incident.quick_sync == "idle" and not incident.management_call.active, "retry reconnects the opening, optional scene, call and gated boss route")
	scene.queue_free()
	paused = false
	await frames(3)
	print("RESULT: ", failures, " failure(s)")
	quit(0 if failures == 0 else 1)
