extends "res://tests/release_tests.gd"

func _run() -> void:
	app = load("res://game/release/front_end.tscn").instantiate()
	app.preferences.path = TEST_SETTINGS
	root.add_child(app)
	current_scene = app
	app.start_incident()
	scene = app.session
	incident = scene.get_node("Incident")
	player = scene.get_node("Player")
	var voice: Node = incident.voice
	await frames(40)
	check(voice.lines.size() == 77 and voice.current_line == "doc_office", "the cold open requests the authored narrator line")
	voice.clear()
	voice.request("enemy")
	await frames(2)
	check(voice.current_line == "enemy" and "This was not in the ticket." in voice.subtitle, "spoken line and subtitle share manifest text")
	voice.request("enemy")
	voice.request("debt")
	check(voice.queue.is_empty(), "repeated events and optional combat cooldown cannot create backlog")
	voice.request("alert")
	await frames(2)
	check(voice.current_line == "alert", "critical information interrupts lower-priority reaction")
	for id: String in ["eta", "investigate", "contain", "rca", "visibility"]:
		voice.request(id)
	check(voice.queue.size() == 3 and voice.queue[0] == "investigate", "queue stays bounded and highest pending priority plays first")
	app.pause_incident()
	await frames(2)
	var left: float = voice.line_left
	await frames(60)
	check(voice.line_left == left and voice.subtitle.is_empty(), "pause suspends speech time and subtitles")
	app.open_settings()
	app.change_setting("voice", 0.0)
	app.change_setting("subtitles", false)
	check(AudioServer.is_bus_mute(AudioServer.get_bus_index("Voice")), "voice volume mutes its dedicated bus")
	app.go_back()
	app.resume_incident()
	await frames(3)
	check(voice.line_left < left and voice.subtitle.is_empty(), "subtitle preference preserves continuing muted speech timing")
	app.change_setting("subtitles", true)
	await frames(2)
	check(not voice.subtitle.is_empty(), "subtitles can return mid-line")
	# A real missing stream must use a bounded readable fallback without engine errors.
	voice.clear(true)
	var original_path: String = voice.lines.enemy.audio
	voice.lines.enemy.audio = "res://assets/audio/voices/intentionally_missing.ogg"
	voice.request("enemy")
	await frames(2)
	check(not voice.using_audio and voice.line_left > 0, "missing clip falls back to timed subtitles")
	await frames(240)
	check(voice.current_line.is_empty(), "missing clip never waits for an audio finished signal")
	voice.lines.enemy.audio = original_path
	incident.presentation.skip()
	check(voice.current_line.is_empty() and voice.queue.is_empty(), "skip discards old opening speech")
	await frames(130)
	check(is_instance_valid(incident.active_enemy), "voice scheduling never blocks combat spawn")
	incident._offer_upgrade(incident.Stage.INVESTIGATION)
	voice.clear(true)
	voice.request("investigate")
	await frames(5)
	check(voice.suspended and voice.current_line.is_empty(), "choice modal holds queued speech without showing captions")
	incident.choose_upgrade(0)
	player.position = incident.CONSOLE_POSITION
	incident.inspect_console()
	check(voice.seen.has("evidence_open"), "console interaction triggers evidence speech")
	incident.choose_system(3)
	incident.choose_corporate(1)
	await frames(2)
	check(voice.current_line == "not_found" and incident.presentation.sequence == ["evidence_confirmed", "mgmt_estimate"], "correct evidence, confirmation and the chosen management reply play in order")
	# Fixture moves only stages; original boss timing and mechanics remain live.
	incident._cleanup()
	incident._enter(incident.Stage.BOSS)
	await frames(2)
	check(voice.current_line == "gate_open" and not incident.boss_triggered, "boss stage opens the gate before any arrival")
	await enter_vault()
	check(voice.current_line == "variance_intro" and voice.positional.get_parent() == voice, "boss arrival uses scene-owned positional speech")
	check(voice.positional.global_position.distance_to(incident.arrival_site() + Vector3.UP * 1.5) < .01, "arrival speech originates at the boss site")
	incident.presentation.skip()
	var boss: CharacterBody3D = incident.active_enemy
	boss.exposed = true
	boss.receive_damage(400, player.position)
	await frames(2)
	check(voice.seen.has("variance_half") and voice.current_line == "variance_half", "surviving half-health event speaks once")
	boss.position.x += 2
	await frames(2)
	check(voice.positional.global_position.distance_to(boss.global_position + Vector3.UP * 1.5) < .15, "positional speech follows the moving boss")
	boss.exposed = true
	boss.receive_damage(10000, player.position)
	await frames(3)
	check(app.page == "report" and voice.current_line == "victory_thanks" and not voice.suspended, "victory speech plays over paused report")
	check(app.report_subtitle.text == voice.subtitle and not voice.subtitle.is_empty(), "report slot shows synchronized terminal subtitle")
	await frames(600)
	check(voice.seen.has("postmortem") and voice.current_line != "victory", "postmortem follows terminal reaction without blocking report")
	app.restart_incident()
	check(voice.seen.is_empty() and voice.current_line.is_empty() and voice.queue.is_empty(), "restart immediately clears all old speech")
	await frames(3)
	check(incident.presentation.short_opening, "quick retry remains intact")
	incident.fail()
	await frames(3)
	check(voice.current_line == "defeat" and not voice.suspended, "defeat has its own report response")
	app.open_settings()
	await frames(3)
	left = voice.line_left
	await frames(30)
	check(voice.suspended and voice.line_left == left, "settings suspends terminal speech too")
	app.go_back()
	await frames(3)
	check(not voice.suspended and voice.line_left < left, "returning to report resumes the same terminal line")
	var weak: WeakRef = weakref(voice)
	app.main_menu()
	await frames(3)
	check(weak.get_ref() == null, "menu unload frees speech players and cache with incident")
	var saved: RefCounted = load("res://game/release/preferences.gd").new()
	saved.path = TEST_SETTINGS
	saved.load_settings()
	check(saved.values.voice == 0 and saved.values.subtitles, "voice preferences survive reload")
	var config: ConfigFile = ConfigFile.new()
	config.set_value("preferences", "master", .4)
	config.save(TEST_SETTINGS)
	saved.load_settings()
	check(saved.values.voice == .8 and saved.values.subtitles, "old settings files acquire voice defaults")
	config.set_value("preferences", "voice", "bad")
	config.set_value("preferences", "subtitles", 42)
	config.save(TEST_SETTINGS)
	saved.load_settings()
	check(saved.values.voice == .8 and saved.values.subtitles, "malformed voice settings use safe defaults")
	DirAccess.remove_absolute(TEST_SETTINGS)
	app.queue_free()
	paused = false
	await frames(3)
	print("RESULT: ", failures, " failure(s)")
	quit(0 if failures == 0 else 1)
