# Share LF text files between macOS and Windows; preserve binary content.
* text=auto eol=lf
*.gd text eol=lf
*.tscn text eol=lf
*.tres text eol=lf
*.godot text eol=lf
*.uid text eol=lf
*.sh text eol=lf
*.glb binary
*.blend binary
*.png binary
*.jpg binary
*.ogg binary
*.wav binary

# Milestone 12+: outside binary assets use Git LFS. Earlier tracked binaries stay in Git.
assets/fonts/**/*.ttf filter=lfs diff=lfs merge=lfs -text
assets/fonts/**/*.otf filter=lfs diff=lfs merge=lfs -text
assets/environment/**/*.png filter=lfs diff=lfs merge=lfs -text
assets/environment/**/*.jpg filter=lfs diff=lfs merge=lfs -text
assets/environment/**/*.exr filter=lfs diff=lfs merge=lfs -text
assets/environment/**/*.hdr filter=lfs diff=lfs merge=lfs -text
assets/environment/**/*.glb filter=lfs diff=lfs merge=lfs -text
assets/characters/**/*.glb filter=lfs diff=lfs merge=lfs -text
assets/characters/**/*.png filter=lfs diff=lfs merge=lfs -text
assets/characters/**/*.jpg filter=lfs diff=lfs merge=lfs -text
assets/audio/sfx/**/*.ogg filter=lfs diff=lfs merge=lfs -text
assets/audio/sfx/**/*.wav filter=lfs diff=lfs merge=lfs -text
assets/audio/music/**/*.ogg filter=lfs diff=lfs merge=lfs -text
assets/audio/music/**/*.wav filter=lfs diff=lfs merge=lfs -text
assets/characters/**/*.fbx filter=lfs diff=lfs merge=lfs -text
assets/enemies/**/*.fbx filter=lfs diff=lfs merge=lfs -text
assets/enemies/**/*.png filter=lfs diff=lfs merge=lfs -text
